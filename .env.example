# ==============================================================================
# VendorIQ Enterprise Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND CONFIGURATION (Vite prefix: VITE_)
# ------------------------------------------------------------------------------
# Base API URL where the backend Express API is hosted.
# - For Local Development: http://localhost:3001/api
# - For Vercel Production: Leave empty (it automatically defaults to '/api' on the same domain) or set to '/api'
VITE_API_URL=http://localhost:3001/api

# Real-time SSE Stream URL (optional, defaults to ${VITE_API_URL}/notifications/stream)
VITE_SSE_URL=http://localhost:3001/api/notifications/stream

# ------------------------------------------------------------------------------
# 2. BACKEND & SERVER CONFIGURATION
# ------------------------------------------------------------------------------
# Port for the local Express server (Vercel automatically sets this in serverless mode)
PORT=3001
NODE_ENV=development

# ------------------------------------------------------------------------------
# 3. APPLICATION & AI INTEGRATION (Optional)
# ------------------------------------------------------------------------------
# Public URL where the application is deployed (e.g. https://vendoriq.vercel.app)
APP_URL=http://localhost:3000

# Gemini AI API Key (Optional: for AI analytics features)
GEMINI_API_KEY=your_gemini_api_key_here
